# Copy to .env.local. Only VITE_ variables reach the browser bundle; the rest
# are read by the bot API (server/bot-api.ts) on the Vite or Vercel server.

# Transport: "webrtc" (SmallWebRTC, the default) or "daily". Read by both the
# browser and the start endpoint, so the two always agree.
VITE_BOT_TRANSPORT=webrtc

# Where sessions start: the local runner (`uv run bot.py` in ../server)...
BOT_START_URL=http://localhost:7860/start
# ...or the agent on Pipecat Cloud:
# BOT_START_URL=https://api.pipecat.daily.co/v1/public/<agent-name>/start

# Pipecat Cloud public API key (pk_...), required when BOT_START_URL points at
# Pipecat Cloud. Server only: never give it a VITE_ prefix.
BOT_START_PUBLIC_API_KEY=
